# The deployed Cloud Function's HTTPS URL (public — safe to expose to the
# browser, unlike the Google credentials in functions/.env.example, which
# never leave the server). Vite only exposes vars prefixed with VITE_.
#
# Get this after your first `firebase deploy --only functions` — it's
# printed in the deploy output, and also visible in the Firebase Console
# under Functions. It looks like:
#   https://us-central1-best-driving-school-e6149.cloudfunctions.net/createBooking
VITE_CALENDAR_FUNCTION_URL=https://REGION-PROJECT_ID.cloudfunctions.net/createBooking

# Same idea, for the "Pay Now" Stripe Checkout Cloud Function. Public —
# it's just an endpoint URL, no credentials.
VITE_STRIPE_CHECKOUT_FUNCTION_URL=https://REGION-PROJECT_ID.cloudfunctions.net/createCheckoutSession
