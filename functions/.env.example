# ─────────────────────────────────────────────────────────────
# These four values authenticate the service account with domain-wide
# delegation to create Calendar events. NEVER commit real values.
#
# PRODUCTION: don't put real values in a .env file at all — set them as
# Firebase secrets instead, so they're encrypted and never on disk:
#   firebase functions:secrets:set GOOGLE_CLIENT_EMAIL
#   firebase functions:secrets:set GOOGLE_PRIVATE_KEY
#   firebase functions:secrets:set GOOGLE_CALENDAR_ID
#   firebase functions:secrets:set GOOGLE_IMPERSONATE_EMAIL
# Each prompts you to paste the value; Firebase stores it in Secret Manager.
#
# LOCAL EMULATOR TESTING ONLY: copy this file to `functions/.env.local`
# (already gitignored) and fill in real values there to run
# `npm run serve` against your real Google Calendar. Never use
# `functions/.env` (also gitignored, but .env.local is the documented
# convention for the emulator to load secret-like values locally).
# ─────────────────────────────────────────────────────────────

# The service account's client_email, from the downloaded JSON key
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The service account's private_key, from the downloaded JSON key.
# Keep the \n sequences literal (don't turn them into real line breaks) —
# googleCalendar.js converts them back to real newlines at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"

# The calendar to create events on — your business calendar's ID
# (Calendar Settings → Integrate calendar → Calendar ID). Often looks
# like an email address, or "primary" for the impersonated user's own calendar.
GOOGLE_CALENDAR_ID=your-business-calendar-id@group.calendar.google.com

# The real Workspace user the service account impersonates for
# domain-wide delegation — this is what lets it actually invite attendees.
GOOGLE_IMPERSONATE_EMAIL=you@yourworkspacedomain.com

# ─────────────────────────────────────────────────────────────
# Stripe — online "Pay Now" checkout. Set as secrets the same way:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# ─────────────────────────────────────────────────────────────

# Dashboard → Developers → API keys → Secret key (sk_test_... while
# testing, sk_live_... once you switch the Stripe account out of test mode)
STRIPE_SECRET_KEY=sk_test_...

# Dashboard → Developers → Webhooks → your endpoint → Signing secret
# (whsec_...) — created after the createCheckoutSession/stripeWebhook
# functions are deployed, since the webhook endpoint needs their real URL
STRIPE_WEBHOOK_SECRET=whsec_...
