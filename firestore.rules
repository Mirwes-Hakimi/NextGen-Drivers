rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this in sync with ADMIN_EMAILS in src/components/AdminRoute.jsx —
    // it's the same owner-access list, enforced here at the database level
    // instead of just in the UI.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["info@yourbds.com"];
    }

    match /bookings/{bookingId} {
      // Booking is open to guests too (see BookingPage.jsx), so anyone can
      // create one — but not read, update, or delete other people's bookings.
      allow create: if true;

      // Fetching ONE booking by its exact ID is allowed for anyone — needed
      // by guests landing on the post-Stripe-payment success page
      // (BookingSuccess.jsx), which has no login of its own. This is safe
      // because Firestore's auto-generated IDs are effectively unguessable;
      // nobody can browse/enumerate bookings this way. Querying/listing the
      // whole collection stays restricted to the admin or the owning user.
      allow get: if true;
      allow list: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.userId);

      // The admin can update anything (status changes, session edits in
      // AdminPage.jsx); a logged-in user can update their own booking.
      //
      // Anyone — including guests — may flip `postPaymentProcessed` to
      // true, but ONLY once `paymentStatus` is already "paid", and ONLY
      // that one field. `paymentStatus` itself can only ever be set to
      // "paid" by the Stripe webhook (functions/index.js — uses the Admin
      // SDK, which bypasses these rules entirely), never by a client. That
      // keeps this one client-writable field from ever being used to fake
      // a payment.
      allow update: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.userId) ||
        (resource.data.paymentStatus == "paid" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["postPaymentProcessed"]) &&
          request.resource.data.postPaymentProcessed == true);

      // Only the admin can permanently delete a booking (AdminPage.jsx's
      // "Delete Permanently" button, gated behind a typed confirmation).
      allow delete: if isAdmin();
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
